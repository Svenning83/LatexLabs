# Image generation provider: gemini | openai | mock
# Default: gemini if GEMINI_API_KEY set, else openai if OPENAI_API_KEY set, else mock
LATEXLABS_IMAGE_PROVIDER=

# Google Gemini image generation (recommended - strong multi-reference conditioning)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
LATEXLABS_GEMINI_MODEL=gemini-2.5-flash-image

# OpenAI image generation (gpt-image-2.5-sunburst via Images API edits endpoint)
OPENAI_API_KEY=
LATEXLABS_OPENAI_MODEL=gpt-image-2.5-sunburst
# low | medium | high | auto (default: auto ~ high). medium cuts cost ~3x for iteration
LATEXLABS_OPENAI_QUALITY=

# Public base URL used for share links (optional; falls back to request origin)
LATEXLABS_BASE_URL=

# Free-tier gate: successful generations per visitor before an access code is
# required (default 3). Comma-separated tester codes unlock via /api/access.
LATEXLABS_FREE_LIMIT=
LATEXLABS_ACCESS_CODES=
# Optional: dedicated secret for signing the access cookie. Falls back to
# OPENAI_API_KEY when unset.
LATEXLABS_ACCESS_SECRET=
